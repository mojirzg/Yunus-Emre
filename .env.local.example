# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/seed.ts (never expose in client bundles or NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Local Supabase CLI only (put these in root `.env`, NOT `.env.local`, when running local Supabase;
# for hosted Supabase Cloud, configure Google Client ID & Secret in the Supabase Dashboard instead)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
